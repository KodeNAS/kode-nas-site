---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="KODE NAS — pebble v1"
  description="The KODE NAS hardware page lives here. For the operating system, visit /os."
  path="/"
>
  <main class="splash">
    <div class="splash-inner">
      <div class="splash-brand">
        {/* Inline SVG so the K mark inherits currentColor in both themes. */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 40 40"
          width="36"
          height="36"
          aria-label="KODE NAS"
          role="img"
        >
          <path fill="currentColor" d="M 4 4 H 12 V 17 L 26 4 H 38 L 21 20 L 38 36 H 26 L 12 23 V 36 H 4 Z" />
        </svg>
        <span class="splash-word">KODE<span class="splash-word-2">NAS</span></span>
      </div>

      <h1 class="splash-title">pebble v1</h1>
      <p class="splash-sub">
        The hardware page is coming soon. For the operating system —
      </p>

      <a class="splash-cta" href="/os">
        Visit KODE OS
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </main>
</Layout>

<style>
  .splash {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 4rem 1.5rem;
    position: relative;
  }
  .splash::before {
    content: "";
    position: absolute;
    inset: -10% 30% auto -10%;
    height: 60vh;
    background: radial-gradient(ellipse at center, rgba(45, 95, 78, 0.22), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
  }
  .splash-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .splash-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
  }
  .splash-word {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .splash-word-2 {
    margin-left: 0.35rem;
    color: var(--fg-2);
    font-weight: 400;
  }
  .splash-title {
    margin: 1.25rem 0 0.25rem;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .splash-sub {
    margin: 0;
    color: var(--fg-2);
    max-width: 36ch;
  }
  .splash-cta {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 6px 16px rgba(0,0,0,0.22);
    transition: background 150ms ease, transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .splash-cta:hover { background: var(--primary-hover); transform: translateY(-1px); }
  .splash-cta:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--glow), inset 0 1px 0 rgba(255,255,255,0.18), 0 6px 16px rgba(0,0,0,0.22);
  }
</style>
