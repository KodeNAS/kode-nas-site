---
/**
 * Three large screenshot slots. No real product screenshots exist yet —
 * brand-coloured placeholder canvases with captions, per the brief.
 */
const shots = [
  {
    caption: "Beginner dashboard",
    body: "Apps, files, family, and system status — all on one screen, drag-to-rearrange.",
    pose: "wide" as const,
  },
  {
    caption: "First-boot wizard",
    body: "Wi-Fi, accounts and a starter pack of apps in under five minutes.",
    pose: "narrow" as const,
  },
  {
    caption: "Family profiles",
    body: "One sign-in per person — kids included.",
    pose: "narrow" as const,
  },
];
---

<section class="shots">
  <div class="rail">
    <header class="section-header" data-reveal>
      <span class="label-meta">Screenshots</span>
      <h2 class="section-title">What you'll actually see</h2>
    </header>

    <div class="shots-grid">
      <figure class="shot shot-wide tile" data-reveal>
        <div class="shot-canvas shot-canvas-wide" aria-hidden="true"></div>
        <figcaption>
          <h3>{shots[0].caption}</h3>
          <p>{shots[0].body}</p>
        </figcaption>
      </figure>

      <figure class="shot shot-narrow tile" data-reveal style="--reveal-delay: 80ms;">
        <div class="shot-canvas shot-canvas-narrow" aria-hidden="true"></div>
        <figcaption>
          <h3>{shots[1].caption}</h3>
          <p>{shots[1].body}</p>
        </figcaption>
      </figure>

      <figure class="shot shot-narrow tile" data-reveal style="--reveal-delay: 140ms;">
        <div class="shot-canvas shot-canvas-narrow" aria-hidden="true"></div>
        <figcaption>
          <h3>{shots[2].caption}</h3>
          <p>{shots[2].body}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .shots { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .section-header { max-width: 640px; margin-bottom: 2.25rem; }
  .section-title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .shots-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 860px) {
    .shots-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "wide wide"
        "n1 n2";
    }
    .shot-wide { grid-area: wide; }
  }

  .shot {
    padding: 1rem 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }

  .shot-canvas {
    border-radius: 14px;
    border: 1px solid var(--border);
    /* Brand-coloured placeholder canvas — DESIGN.md palette, no stock imagery */
    background:
      radial-gradient(ellipse at 25% 20%, rgba(63, 122, 102, 0.35), transparent 55%),
      radial-gradient(ellipse at 75% 80%, rgba(31, 68, 56, 0.45), transparent 55%),
      linear-gradient(135deg, #1F4438 0%, #2D5F4E 50%, #11201f 100%);
    position: relative;
    overflow: hidden;
  }
  .shot-canvas::before {
    /* subtle window-light reflection on the placeholder, hints at glass UI */
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.07) 35%, transparent 60%),
      repeating-linear-gradient(90deg, transparent 0 20%, rgba(255,255,255,0.02) 20% 21%);
    pointer-events: none;
  }
  .shot-canvas-wide  { aspect-ratio: 21 / 10; }
  .shot-canvas-narrow { aspect-ratio: 4 / 3; }

  figcaption {
    padding: 0 0.25rem 0.25rem;
  }
  figcaption h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    line-height: 1.3;
  }
  figcaption p {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
