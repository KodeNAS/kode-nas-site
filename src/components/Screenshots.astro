---
/**
 * Real product screenshots (v0.2.0-alpha). All three are taken on the same
 * misty-forest wallpaper for visual continuity. Captions stay terse — the
 * image is the message.
 */

const shots = [
  {
    src: "/screenshots/tour.webp",
    alt: "A guided tour bubble highlighting the Clock widget on the KODE OS dashboard, explaining how to switch between digital and analog time.",
    caption: "Tours, built in",
    body: "Each widget and each app comes with a built-in walkthrough — no separate manual to hunt for.",
    pose: "wide" as const,
    w: 1600,
    h: 996,
  },
  {
    src: "/screenshots/wizard-style.webp",
    alt: "First-boot wizard step asking the user to pick Beginner, Normal or Developer mode.",
    caption: "Pick your style",
    body: "Beginner mode hides anything technical. Switch later from settings.",
    pose: "narrow" as const,
    w: 1600,
    h: 1000,
  },
  {
    src: "/screenshots/wizard-apps.webp",
    alt: "First-boot wizard step showing a curated list of apps to install — Immich, Jellyfin, File Browser, Pi-hole and Home Assistant.",
    caption: "Pick your apps",
    body: "Browse a curated catalogue on first boot. Apps install while you finish setting up.",
    pose: "narrow" as const,
    w: 1600,
    h: 1001,
  },
];
---

<section class="shots">
  <div class="rail">
    <header class="section-header" data-reveal>
      <span class="label-meta">Screenshots</span>
      <h2 class="section-title">What you'll actually see</h2>
    </header>

    <div class="shots-grid">
      <figure class="shot shot-wide tile" data-reveal>
        <a class="shot-canvas" href={shots[0].src} target="_blank" rel="noreferrer noopener" aria-label={`Open ${shots[0].caption} screenshot full-size`}>
          <img src={shots[0].src} alt={shots[0].alt} width={shots[0].w} height={shots[0].h} loading="lazy" decoding="async" />
        </a>
        <figcaption>
          <h3>{shots[0].caption}</h3>
          <p>{shots[0].body}</p>
        </figcaption>
      </figure>

      <figure class="shot shot-narrow tile" data-reveal style="--reveal-delay: 80ms;">
        <a class="shot-canvas" href={shots[1].src} target="_blank" rel="noreferrer noopener" aria-label={`Open ${shots[1].caption} screenshot full-size`}>
          <img src={shots[1].src} alt={shots[1].alt} width={shots[1].w} height={shots[1].h} loading="lazy" decoding="async" />
        </a>
        <figcaption>
          <h3>{shots[1].caption}</h3>
          <p>{shots[1].body}</p>
        </figcaption>
      </figure>

      <figure class="shot shot-narrow tile" data-reveal style="--reveal-delay: 140ms;">
        <a class="shot-canvas" href={shots[2].src} target="_blank" rel="noreferrer noopener" aria-label={`Open ${shots[2].caption} screenshot full-size`}>
          <img src={shots[2].src} alt={shots[2].alt} width={shots[2].w} height={shots[2].h} loading="lazy" decoding="async" />
        </a>
        <figcaption>
          <h3>{shots[2].caption}</h3>
          <p>{shots[2].body}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .shots { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .section-header { max-width: 640px; margin-bottom: 2.25rem; }
  .section-title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .shots-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 860px) {
    .shots-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "wide wide"
        "n1 n2";
    }
    .shot-wide { grid-area: wide; }
  }

  .shot {
    padding: 0.85rem 0.85rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    overflow: hidden;
    margin: 0;
  }

  .shot-canvas {
    display: block;
    border-radius: 12px;
    border: 1px solid var(--border);
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    /* The screenshots carry their own wallpaper backdrop — let them show
       through without forcing an aspect ratio. */
  }
  .shot-canvas img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot-canvas:hover img {
    transform: scale(1.015);
  }
  .shot-canvas:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--glow);
  }

  figcaption {
    padding: 0 0.4rem 0.25rem;
  }
  figcaption h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    line-height: 1.3;
  }
  figcaption p {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
