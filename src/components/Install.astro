---
import Icon from "./Icon.astro";

/**
 * v0.2 install flow — flash and boot. No SSH, no install script.
 */

const steps = [
  {
    n: "1",
    title: "Download the image",
    body: "Grab the latest .img.xz from the GitHub release. About 475 MB compressed.",
  },
  {
    n: "2",
    title: "Flash with Raspberry Pi Imager",
    body: "Open Raspberry Pi Imager, pick “Use custom”, choose the .img.xz, and write it to your SD card.",
  },
  {
    n: "3",
    title: "Boot and open the wizard",
    body: "Plug in power and ethernet. After a few minutes, open http://pebble.local/ in any browser on your network.",
  },
];

const installCmd = `# Optional: verify the download before flashing
curl -fLO https://github.com/KodeNAS/kode-os/releases/download/v0.2.0-alpha/kode-os-v0.2.0-alpha-pi5-lite.img.xz.sha256
sha256sum -c kode-os-v0.2.0-alpha-pi5-lite.img.xz.sha256`;
---

<section id="install" class="install">
  <div class="rail">
    <header class="section-header" data-reveal>
      <span class="label-meta">Install</span>
      <h2 class="section-title">Three steps, one cup of coffee</h2>
      <p class="section-sub">
        KODE OS ships as a single image based on Raspberry Pi OS Lite — you
        flash it once and boot. No terminal, no install script.
      </p>
    </header>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step tile" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
          <span class="step-num tabular">{s.n}</span>
          <div class="step-text">
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="install-cli tile" data-reveal style="--reveal-delay: 240ms;">
      <header class="cli-head">
        <span class="cli-prompt"><Icon name="terminal" size={14} /> verify your download (optional)</span>
        <button type="button" class="cli-copy" data-copy-target="#install-cmd" aria-label="Copy install command" title="Copy">
          <span class="copy-default"><Icon name="copy" size={14} /></span>
          <span class="copy-done"><Icon name="check" size={14} /></span>
        </button>
      </header>
      <pre class="code" id="install-cmd"><code>{installCmd}</code></pre>
      <p class="cli-foot">
        Tested on Raspberry Pi 5 (4 GB). The 8 GB model is expected to work but
        is unverified this release. Pi 4 support is on the roadmap — track it
        on <a href="https://github.com/KodeNAS/kode-os" target="_blank" rel="noreferrer noopener">GitHub</a>.
      </p>
    </div>

    <a class="install-docs" href="https://docs.kodenas.dev/os/installation/" target="_blank" rel="noreferrer noopener" data-reveal style="--reveal-delay: 300ms;">
      Read the full installation guide
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-copy-target]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var sel = btn.getAttribute("data-copy-target");
        var target = sel ? document.querySelector(sel) : null;
        if (!target) return;
        var text = target.textContent || "";
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text);
        } else {
          var ta = document.createElement("textarea");
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); } catch (e) {}
          document.body.removeChild(ta);
        }
        btn.classList.add("is-copied");
        setTimeout(function () { btn.classList.remove("is-copied"); }, 1600);
      });
    });
  })();
</script>

<style>
  .install { padding-block: clamp(3.5rem, 7vw, 6rem); }

  .section-header { max-width: 640px; margin-bottom: 2.25rem; }
  .section-title {
    margin: 0.5rem 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .section-sub { margin: 0; color: var(--fg-2); max-width: 56ch; }

  .steps {
    list-style: none;
    padding: 0; margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  }
  .step {
    padding: 1.25rem 1.3rem 1.4rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .step-num {
    flex-shrink: 0;
    width: 34px; height: 34px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--tint);
    color: var(--primary-hover);
    font-weight: 600;
    font-size: 0.9375rem;
    border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
  }
  :global(.light) .step-num { color: var(--primary-active); }
  .step-title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    line-height: 1.3;
  }
  .step-body { margin: 0; color: var(--fg-2); font-size: 0.9rem; line-height: 1.5; }

  .install-cli {
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .cli-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    gap: 1rem;
  }
  .cli-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg-3);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .cli-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--bg-elev-strong);
    border: 1px solid var(--border-strong);
    color: var(--fg-2);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease, transform 200ms ease;
  }
  .cli-copy:hover { background: var(--bg-elev-strong); border-color: var(--primary-hover); color: var(--fg); }
  .cli-copy:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--glow);
  }
  .cli-copy .copy-default,
  .cli-copy .copy-done {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cli-copy .copy-done { display: none; color: var(--primary-hover); }
  .cli-copy.is-copied .copy-default { display: none; }
  .cli-copy.is-copied .copy-done { display: inline-flex; }

  .install-cli .code {
    margin: 0;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    border: 1px solid var(--border);
    color: var(--fg);
    line-height: 1.6;
    white-space: pre;
  }
  .cli-foot {
    margin: 0.75rem 0 0;
    color: var(--fg-3);
    font-size: 0.8125rem;
  }
  .cli-foot a { color: var(--fg-2); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .cli-foot a:hover { color: var(--fg); border-bottom-color: var(--fg); }

  .install-docs {
    margin-top: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--primary-hover);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 150ms ease, gap 200ms ease;
  }
  :global(.light) .install-docs { color: var(--primary-active); }
  .install-docs:hover { color: var(--fg); gap: 0.55rem; }
  .install-docs:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--glow);
    border-radius: 4px;
  }
</style>
