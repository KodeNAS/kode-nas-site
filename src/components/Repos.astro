---
import Icon from "./Icon.astro";

const repos = [
  {
    name: "kode-os",
    url: "https://github.com/KodeNAS/kode-os",
    role: "the system",
    body:
      "Installer, OLED display daemon, branding, system services. Run this on a fresh Raspberry Pi 5 and you have a pebble.",
    tag: "Apache 2.0",
  },
  {
    name: "kode-os-ui",
    url: "https://github.com/KodeNAS/kode-os-ui",
    role: "the dashboard",
    body:
      "The web dashboard your family signs into. Vue 2 on Bulma + Buefy. Lives in its own repo so we can ship UI updates without re-flashing the SD card.",
    tag: "Apache 2.0",
  },
];
---

<section class="repos">
  <div class="rail">
    <header class="section-header" data-reveal>
      <span class="label-meta">Two repos</span>
      <h2 class="section-title">System and surface, split on purpose</h2>
      <p class="section-sub">
        The OS underneath and the dashboard on top live in separate repos.
        Easier to read, easier to ship.
      </p>
    </header>

    <div class="repos-grid">
      {repos.map((r, i) => (
        <a
          class="repo-card tile"
          href={r.url}
          target="_blank"
          rel="noreferrer noopener"
          data-reveal
          style={`--reveal-delay: ${i * 80}ms;`}
        >
          <header class="repo-head">
            <Icon name="github" size={18} class="repo-mark" />
            <span class="repo-name tabular">KodeNAS / {r.name}</span>
            <span class="repo-tag">{r.tag}</span>
          </header>
          <p class="repo-role">{r.role}</p>
          <p class="repo-body">{r.body}</p>
          <span class="repo-cta">
            Visit on GitHub <Icon name="arrow-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .repos { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .section-header { max-width: 640px; margin-bottom: 2.25rem; }
  .section-title {
    margin: 0.5rem 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .section-sub { margin: 0; color: var(--fg-2); max-width: 56ch; }

  .repos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 760px) {
    .repos-grid { grid-template-columns: 1fr 1fr; }
  }

  .repo-card {
    padding: 1.4rem 1.4rem 1.5rem;
    text-decoration: none;
    color: var(--fg);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
                border-color 200ms ease,
                background 200ms ease;
  }
  .repo-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    background: var(--bg-elev-strong);
  }
  .repo-card:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--glow), var(--shadow-tile);
  }

  .repo-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .repo-mark { color: var(--fg-2); }
  .repo-name {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.875rem;
    color: var(--fg);
  }
  .repo-tag {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--tint);
    color: var(--primary-hover);
  }
  :global(.light) .repo-tag { color: var(--primary-active); }
  .repo-role {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    font-weight: 600;
  }
  .repo-body {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    flex: 1;
  }
  .repo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--primary-hover);
    font-size: 0.875rem;
    font-weight: 500;
  }
  :global(.light) .repo-cta { color: var(--primary-active); }
</style>
