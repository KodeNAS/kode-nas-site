---
import Icon from "./Icon.astro";
---

<section class="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <img src="/wallpaper.jpg" alt="" class="hero-wallpaper" />
    <div class="hero-scrim"></div>
  </div>

  <div class="rail hero-content">
    <div class="hero-kicker" data-reveal>
      <span class="kicker-dot"></span>
      <span>Alpha · v0.1.0</span>
      <span class="kicker-sep">·</span>
      <a href="https://github.com/KodeNAS/kode-os/releases" target="_blank" rel="noreferrer noopener">
        Read the release notes
      </a>
    </div>

    <h1 class="hero-title" data-reveal style="--reveal-delay: 60ms;">
      Your private cloud server <span class="hero-em">in&nbsp;5&nbsp;minutes</span>.
    </h1>

    <p class="hero-sub" data-reveal style="--reveal-delay: 120ms;">
      KODE OS turns a Raspberry Pi into a calm, private home for your apps,
      files and photos. No accounts. No telemetry. Just yours.
    </p>

    <div class="hero-cta" data-reveal style="--reveal-delay: 180ms;">
      <a class="btn-primary" href="https://github.com/KodeNAS/kode-os/releases" target="_blank" rel="noreferrer noopener">
        <Icon name="download" size={16} />
        Get KODE OS
      </a>
      <a class="btn-secondary" href="https://github.com/KodeNAS/kode-os" target="_blank" rel="noreferrer noopener">
        <Icon name="github" size={16} />
        View on GitHub
      </a>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 9vw, 8rem);
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-wallpaper {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.32;
    /* very gently desaturated — keeps the forest tone but doesn't fight the brand teal */
    filter: saturate(0.65);
  }
  :global(.light) .hero-wallpaper { opacity: 0.28; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: var(--scrim);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--fg-2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .hero-kicker a { color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--border-strong); }
  .hero-kicker a:hover { border-bottom-color: var(--fg); }
  .kicker-dot {
    width: 6px; height: 6px;
    background: #8a5a00;
    border-radius: 999px;
    box-shadow: 0 0 8px rgba(196, 127, 0, 0.55);
  }
  .kicker-sep { color: var(--fg-3); }

  .hero-title {
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 18ch;
  }
  .hero-em {
    background: linear-gradient(135deg, #3F7A66, #2D5F4E);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }
  :global(.light) .hero-em {
    background: linear-gradient(135deg, #2D5F4E, #1F4438);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.55;
    max-width: 52ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-shot {
    position: relative;
    margin-top: 2.5rem;
    width: min(100%, 980px);
  }
  .hero-shot-glow {
    position: absolute;
    inset: auto 10% -40px 10%;
    height: 140px;
    background: radial-gradient(ellipse at center, var(--glow), transparent 70%);
    filter: blur(40px);
    opacity: 0.55;
    z-index: -1;
    pointer-events: none;
  }
  .shot-frame {
    border-radius: 18px;
    background: var(--bg-elev-strong);
    border: 1px solid var(--border-strong);
    overflow: hidden;
    box-shadow: var(--shadow-modal);
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
  }
  .shot-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 10px; height: 10px; border-radius: 999px;
    background: var(--border-strong);
  }
  .shot-url {
    margin-left: 0.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    color: var(--fg-3);
  }
  .shot-canvas {
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 30% 20%, rgba(63, 122, 102, 0.18), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(45, 95, 78, 0.22), transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.10));
    display: grid;
    place-items: center;
  }
  .shot-placeholder {
    text-align: center;
    padding: 1.5rem;
    color: var(--fg-3);
  }
  .shot-placeholder p {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .hero-shot { margin-top: 1.75rem; }
    .hero-title { font-size: clamp(1.85rem, 9vw, 2.4rem); }
  }
</style>
